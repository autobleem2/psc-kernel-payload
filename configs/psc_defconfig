#
# psc_defconfig — Buildroot config for the AutoBleem PSC kernel + rootfs overlay.
#
# This is the tracked, minimal defconfig. Regenerate it after any menuconfig
# change with:   scripts/build.sh savedefconfig    (runs `make savedefconfig`)
# so the diff stays small and reviewable.
#
# Target: MediaTek MT8167 (4x Cortex-A35) running a 32-bit armv7 hardfloat
# userland — Cortex-A7 codegen runs safely on the A35. Kernel is our own
# 4.4.22 fork (autobleem2/psc-kernel); userland is stock Buildroot built from
# source; the AutoBleem-specific files come from board/psc/overlay; the BlueZ
# DualShock (sixaxis) fix is board/psc/patches/bluez5_utils.
#

# ---- Architecture ----
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_EABIHF=y

# ---- Toolchain (Buildroot-built, glibc — the overlay ships its own glibc) ----
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Toolchain kernel headers: public 4.4.x from kernel.org (decoupled from our
# private kernel repo; glibc min-kernel = 4.4, runs on the console's 4.4.22).
BR2_KERNEL_HEADERS_4_4=y
# Newer BlueZ (this Buildroot) uses its upstream sixaxis plugin; the archived
# 5.54 DanTheMans patch is in board/psc/reference-patches (not applied).
BR2_CCACHE=y

# ---- System / init ----
BR2_TARGET_GENERIC_HOSTNAME="PlayStationClassic"
BR2_TARGET_GENERIC_ISSUE="AutoBleem"
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PSC_PATH)/board/psc/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PSC_PATH)/board/psc/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PSC_PATH)/board/psc/post-image.sh"

# ---- Kernel: built SEPARATELY, not by Buildroot ----
# The 4.4 fork needs gcc-6 (gcc>=9/10 break its __asmeq register asserts), while
# the userland here uses Buildroot's newer gcc. So board/psc/build-kernel.sh
# builds the kernel + modules with the console gcc-6 toolchain; post-build.sh
# folds the modules into the rootfs and post-image.sh wraps Image into boot.img.
# BR2_LINUX_KERNEL is therefore OFF.

# ---- Host tools for FIT packaging (post-image) ----
# mkimage from host-uboot-tools; lz4 comes from the container (post-image.sh
# falls back to the system lz4 — host-lz4 is not a defconfig-selectable symbol).
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# ---- Bluetooth stack (BlueZ 5.54 + sixaxis DualShock plugin) ----
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y                 # bluetoothctl
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y                  # hciconfig, hcitool, l2ping ...
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS_HID2HCI=y          # hid2hci: switch HID-mode BT dongles to HCI
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y             # the deprecated tools (needs CLIENT or TOOLS)
BR2_PACKAGE_BLUEZ5_UTILS_EXPERIMENTAL=y           # btmon etc
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_SIXAXIS=y        # DualShock 3 pairing (patched)

# ---- WiFi / networking ----
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_WIRELESS_TOOLS=y                       # iwconfig, iwlist
BR2_PACKAGE_WIRELESS_TOOLS_LIB=y

# ---- Filesystems ----
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y                    # mkntfs, ntfsfix, ntfsinfo ...
BR2_PACKAGE_EXFAT=y                                # mount.exfat-fuse
BR2_PACKAGE_EXFATPROGS=y                           # mkfs.exfat, fsck.exfat (replaces exfat-utils)

# ---- Libraries the overlay ships ----
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
# libform/libmenu/libpanel are built automatically by the ncurses package.
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_PCRE2=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_ELFUTILS=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_XZ=y

# ---- Userland tools ----
BR2_PACKAGE_MC=y                                   # midnight commander
BR2_PACKAGE_NANO=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# ---- Firmware for USB WiFi/BT dongles (kernel modules already built) ----
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y

# ---- Rootfs image: we tar the target ourselves in post-image (abrootfs.tgz) ----
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
# no cpio/ext/initramfs needed
