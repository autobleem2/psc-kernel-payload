#
# psc_next_defconfig — the IMPROVED AutoBleem PSC image.
#
# Same GPU-safe 4.4 kernel and YOUR hand-tuned kernel config as the baseline —
# `next` only ADDS: newer BlueZ + userland (Buildroot 2024.02.x, set by
# build.sh), a broader WiFi driver set (board/psc/linux-extra-wifi.fragment
# merged on top of your config) and the full USB-dongle firmware set.
#
# Build with:  scripts/build.sh -V next all   (or VARIANT=next)
# Regenerate:  scripts/build.sh -V next savedefconfig
#
# NOTE: validate symbol names against Buildroot 2024.02 (a few renamed since
# 2020.02 — exfat, openssl). Do it with `-V next menuconfig` then savedefconfig.
#

# ---- Architecture (identical to baseline) ----
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_ARM_EABIHF=y

# ---- Toolchain (Buildroot-built glibc) ----
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_4_4=y
# `next` does NOT apply the 5.54 DanTheMans sixaxis patch (bluez is newer here);
# it relies on upstream BlueZ DualShock support. Forward-ported PSC patches, if
# needed after hardware testing, go in board/psc/patches-next.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PSC_PATH)/board/psc/patches-next"
BR2_CCACHE=y

# ---- System / init ----
BR2_TARGET_GENERIC_HOSTNAME="PlayStationClassic"
BR2_TARGET_GENERIC_ISSUE="AutoBleem"
# No init: the overlay is laid over the console's own root and must not bring one - BR2_INIT_SYSTEMD
# forced merged /usr (bin, lib, sbin as symlinks, hiding the console's) and shipped its own systemd.
# The console's systemd runs AutoBleem's units from board/psc/overlay (post-build.sh enables them).
BR2_INIT_NONE=y
# eudev only so BlueZ and hid2hci have libudev to build against - post-build.sh removes the daemon and
# the library again; the console's systemd-udevd and libudev serve them at run time
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# the overlayfs whiteouts that switch the console's syslog units off (board/psc/device_table.txt)
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_PSC_PATH)/board/psc/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PSC_PATH)/board/psc/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PSC_PATH)/board/psc/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_PSC_PATH)/board/psc/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PSC_PATH)/board/psc/post-image.sh"

# ---- Kernel: built SEPARATELY (gcc-6), not by Buildroot ----
# build.sh passes board/psc/linux-extra-wifi.fragment to build-kernel.sh for the
# `next` variant, so the extra USB-WiFi drivers are added on top of the base config.
# BR2_LINUX_KERNEL is OFF (see psc_defconfig for why).

# ---- Host tools for FIT packaging ----
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# ---- Bluetooth stack (newer BlueZ + sixaxis) ----
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS_HID2HCI=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_EXPERIMENTAL=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y                # btmon (the 2020 overlay had it)
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_SIXAXIS=y
BR2_PACKAGE_ABBTAGENT=y                           # the agent the sixaxis cable pairing asks (package/abbtagent)

# ---- WiFi / networking ----
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_LIBNL=y
BR2_PACKAGE_DHCPCD=y
# the timezone database (usr/share/zoneinfo + zone.tab/zone1970.tab): PSC-Bios lists and sets the zones from it,
# settime links /etc/localtime into it; the 2020 overlay shipped it (1891 files), the Buildroot payload lost it
# until 2026-09-26 (no zone to choose). post-build.sh drops the etc/localtime + etc/timezone it writes.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_TZ_ZONELIST="default"
BR2_PACKAGE_WIRELESS_TOOLS=y
BR2_PACKAGE_WIRELESS_TOOLS_LIB=y
# curl over OpenSSL with the Mozilla CA bundle: the launcher's online update fetches the channel's
# catalog and stick package with it (psc.ini update_download_command) - 2026-09-23
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# ---- Filesystems (exfatprogs replaces exfat-utils on modern Buildroot) ----
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_EXFAT=y
BR2_PACKAGE_EXFATPROGS=y

# ---- Libraries ----
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_PCRE2=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_ELFUTILS=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_XZ=y

# ---- Userland tools ----
BR2_PACKAGE_MC=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PSC_PATH)/board/psc/busybox.fragment"  # tcpsvd, ftpd, telnetd, tftpd: the 2020 applets

# ---- Firmware: the FULL USB WiFi/BT dongle set (the point of `next`) ----
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8188=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8192=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT61=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7650=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT76X2E=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_CARL9170=y
BR2_PACKAGE_LINUX_FIRMWARE_ATH6K=y
BR2_PACKAGE_LINUX_FIRMWARE_ATH9K_HTC=y
BR2_PACKAGE_LINUX_FIRMWARE_ZD1211=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# ---- Rootfs image ----
BR2_TARGET_ROOTFS_TAR=y
BR2_TARGET_ROOTFS_TAR_GZIP=y
