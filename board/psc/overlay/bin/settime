#!/bin/bash

tzone()
{
  echo "New timezone: $1"
  rm -rf /etc/localtime
  ln -s /usr/share/zoneinfo/$1 /etc/localtime
  echo "$1" > /etc/timezone
  # stick boot (new /init): /etc is RAM - keep the zone name on the stick, abstate tz-in replays it at start
  [ -r /etc/autobleem/abstate.sh ] && { . /etc/autobleem/abstate.sh; ab_tz_save "$1"; }
}

update()
{
  TIME=$(ntpget)
  echo Setting time to: $TIME
  date +"%a %b %e %H:%M:%S %Y" -s "$TIME"
  hwclock -w -l  
}

tz()
{ 
  cat /etc/timezone
}

case $1 in
  tzone|update|tz) $1 $2 $3 ;;
  *) echo "Usage: settime tzone TZNAME | update | tz" ;;
esac
