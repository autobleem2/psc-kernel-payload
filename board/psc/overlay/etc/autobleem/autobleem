PWD=/etc/autobleem

# Stick boot (new /init): the root is an overlay on tmpfs; /data is read-write as in the stock boot (the stick's
# boot.sh makes it read-only only while the AutoBleem launcher runs), and what must survive a reboot (pairings,
# WiFi, zone) is on the stick (abstate.sh). Legacy boot: as always.
AB_NEW=
if [ -r $PWD/abstate.sh ]; then
  . $PWD/abstate.sh
  [ "$(ab_mode)" = new ] && AB_NEW=1
fi

# The console's systemd remounts / read-only (its own fstab). / is an overlay in both boots - the eMMC root is
# only a read-only lower layer under it - so / goes back to read-write in both. Without it the stick boot could
# not write /etc (PSC-Bios: "cannot write /etc/autobleem/ssid.cfg", 2026-10-14).
mount -o remount,rw /

if [ -z "$AB_NEW" ]; then
  # ITS SAFE WE ARE IN OVERLAY
  mount -o remount,rw /data
  mkdir -p /var/lib/bluetooth
  mount --bind /etc/bluetooth/bluetoothd /var/lib/bluetooth
fi

start() {
  if [ -n "$AB_NEW" ]; then
    ab_tz_in
    ab_wifi_in
    ab_bt_mount
  fi
  $PWD/modules start 
  $PWD/rndis start     
  systemctl restart bluetooth
  #rm -rf /var/lib/bluetooth
  #ln -s /etc/bluetooth/bluetoothd /var/lib/bluetooth
}

stop() {
  $PWD/modules stop
  $PWD/rndis stop
  systemctl stop bluetooth
  if [ -n "$AB_NEW" ]; then
    ab_wifi_out
    ab_bt_umount
  fi
  }


case $1 in
  start|stop) "$1" ;;
esac
